{
  "schemaVersion": 1,
  "id": "dandiccf.battery-care",
  "name": "Battery Care",
  "version": "0.6.0",
  "author": "dandiccf",
  "license": "MIT",
  "description": "Honest charge-limit status, battery health, per-app energy use and history, charger warnings, power profiles, and temporary full charging with automatic protection recovery.",
  "kinds": ["bar-widget"],
  "entryPoints": {"barWidget": "BatteryPanel.qml"},
  "omarchy": {"clonedFrom": "omarchy.power"},
  "barWidget": {
    "displayName": "Battery Care",
    "description": "Battery protection and power profiles",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {"showPercentage": true, "historyEnabled": true},
    "schema": [
      {"key": "showPercentage", "type": "boolean", "label": "Show battery percentage", "defaultValue": true},
      {"key": "historyEnabled", "type": "boolean", "label": "Record battery history", "defaultValue": true}
    ]
  }
}
